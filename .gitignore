# macOS
.DS_Store
*.swp

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Translation review: the tool's venv, the reviewer's workbook and Numbers'
# conversion folders (scripts/translations.sh creates them)
scripts/translations/.venv/
scripts/streamin-translations.*
translations-tmp-*/
__pycache__/

# Secrets — never commit
Secrets.xcconfig
StreamIn/Secrets/GeneratedSecrets.swift

# Claude Code: the shared setup (settings, rules, skills, agents, hooks) is
# committed; personal settings, worktrees and session state stay local.
.claude/*
!.claude/settings.json
!.claude/rules/
!.claude/skills/
!.claude/agents/
!.claude/hooks/

# fastlane (if you add it later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
