{
  "sourceLanguage" : "en",
  "strings" : {
    "errorCancelled" : {
      "comment" : "Shown when a request is cancelled mid-flight",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The request was cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud fue cancelada."
          }
        }
      }
    },
    "errorDecoding" : {
      "comment" : "Shown when the API response cannot be parsed (schema drift)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong reading the response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo fue mal leyendo la respuesta."
          }
        }
      }
    },
    "errorNotFound" : {
      "comment" : "Shown when a requested movie or resource does not exist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find what you were looking for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos encontrar lo que está buscando."
          }
        }
      }
    },
    "errorOffline" : {
      "comment" : "Shown when the device has no network connection",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You appear to be offline. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que estás sin conexión. Verifique su conexión e inténtelo de nuevo."
          }
        }
      }
    },
    "errorRateLimited" : {
      "comment" : "Shown when the TMDB API rate-limits the client",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests right now. Please wait a moment and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes. Por favor espere un momento y vuelva a intentarlo."
          }
        }
      }
    },
    "errorServer" : {
      "comment" : "Shown for HTTP 5xx server errors",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server is having trouble. Please try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor está teniendo problemas. Por favor inténtelo de nuevo más tarde."
          }
        }
      }
    },
    "errorTimeout" : {
      "comment" : "Shown when a network request exceeds its timeout",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The request took too long. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitud demasiado larga. Por favor inténtelo de nuevo."
          }
        }
      }
    },
    "errorUnauthorized" : {
      "comment" : "Shown when the TMDB API key is invalid or missing",
