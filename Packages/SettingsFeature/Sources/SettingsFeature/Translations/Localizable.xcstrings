{
  "sourceLanguage": "en",
  "strings": {
    "settingsDone": {
      "comment": "Toolbar button that dismisses the Settings sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        }
      }
    },
    "settingsLanguageFooter": {
      "comment": "Settings: footer under the Language picker, before the restart note.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the language for app text and movie information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el idioma del texto de la app y de la información de las películas."
          }
        }
      }
    },
    "settingsLanguagePicker": {
      "comment": "Label for the language picker control",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma"
          }
        }
      }
    },
    "settingsRegionFooter": {
      "comment": "Settings: footer under the Region picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Determines which streaming services appear for each movie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina qué servicios de streaming aparecen para cada película."
          }
        }
      }
    },
    "settingsRegionPicker": {
      "comment": "Label for the region picker control",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Region"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Región"
          }
        }
      }
    },
    "settingsSubscriptionsBlurb": {
      "comment": "Body text introducing the subscriptions section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the streaming services you pay for. We'll show you which countries carry each film on those services — handy if you have a VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los servicios de streaming que pagas. Te mostraremos en qué países está disponible cada película en esos servicios — útil si tienes una VPN."
          }
        }
      }
    },
    "settingsSubscriptionsHeader": {
      "comment": "Section header for the user's streaming subscription preferences",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My subscriptions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis suscripciones"
          }
        }
      }
    },
    "settingsTitle": {
      "comment": "Navigation bar title for the Settings sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración"
          }
        }
      }
    },
    "settingsLanguageRestartTitle": {
      "comment": "Title of the alert shown after the user changes the app language",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicio necesario"
          }
        }
      }
    },
    "settingsLanguageRestartMessage": {
      "comment": "Body of the restart alert, explaining that the change is saved even if the user defers the restart",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StreamIn needs to relaunch to apply the new language. Your choice is saved either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "StreamIn necesita reiniciarse para aplicar el nuevo idioma. Tu elección ya se ha guardado."
          }
        }
      }
    },
    "settingsLanguageRestartNow": {
      "comment": "Primary button on the restart alert, quits the app so the user can reopen it",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar ahora"
          }
        }
      }
    },
    "settingsLanguageRestartLater": {
      "comment": "Cancel button on the restart alert; defers the relaunch to the user's next manual app open",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más tarde"
          }
        }
      }
    },
    "settingsMoreProvidersWorldwideToggle": {
      "comment": "Services picker: switch under the 'Available in …' heading that lists every service in the world instead of the home region's.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worldwide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el mundo"
          }
        }
      }
    },
    "settingsMoreProvidersSearchPrompt": {
      "comment": "Services picker: placeholder of the search field that filters services by name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search services"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar servicios"
          }
        }
      }
    },
    "settingsStreamingServicesRow": {
      "comment": "Label for the navigation row in Settings that opens the streaming services picker",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming services"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicios de streaming"
          }
        }
      }
    },
    "settingsStreamingServicesNone": {
      "comment": "Trailing summary on the Settings row when the user hasn't selected any streaming services",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno"
          }
        }
      }
    },
    "settingsStreamingServicesCount": {
      "comment": "Trailing summary on the Settings row showing how many streaming services the user has selected. %lld is the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seleccionados"
          }
        }
      }
    },
    "settingsStreamingServicesTitle": {
      "comment": "Navigation title of the pushed streaming services picker screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming Services"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicios de streaming"
          }
        }
      }
    },
    "settingsStreamingServicesAvailableInRegion": {
      "comment": "Section header on the picker screen above providers available in the user's home region. %@ is the localized region name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available in %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibles en %@"
          }
        }
      }
    },
    "settingsStreamingServicesAvailableWorldwide": {
      "comment": "Section header on the picker screen when the worldwide toggle is on",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available worldwide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibles en todo el mundo"
          }
        }
      }
    },
    "settingsStreamingServicesWorldwideFooter": {
      "comment": "Footer explaining when to enable the worldwide toggle on the picker screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful if you have a VPN or accounts in other regions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil si usas una VPN o tienes cuentas en otras regiones."
          }
        }
      }
    },
    "onboardingNavTitle": {
      "comment": "Navigation bar title for the first-launch onboarding screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido"
          }
        }
      }
    },
    "onboardingHeaderTitle": {
      "comment": "Onboarding: headline under the spinning globe, above the services picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the services you pay for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los servicios que pagas"
          }
        }
      }
    },
    "onboardingHeaderSubtitle": {
      "comment": "Onboarding: one line under the headline saying what picking services gets you.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll show where each movie streams on them, here and abroad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te diremos dónde ver cada película con ellos, aquí y fuera."
          }
        }
      }
    },
    "onboardingDone": {
      "comment": "Toolbar button that dismisses the onboarding sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        }
      }
    },
    "settingsAboutTMDB": {
      "comment": "Settings → About: TMDB's required attribution, under their logo; opens themoviedb.org. Wording set by TMDB's terms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This product uses the TMDB API but is not endorsed or certified by TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este producto usa la API de TMDB, pero TMDB no lo respalda ni lo certifica."
          }
        }
      }
    },
    "settingsAboutJustWatch": {
      "comment": "Settings → About: credit for the watch-provider data; opens justwatch.com.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming availability data provided by JustWatch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de disponibilidad en streaming proporcionados por JustWatch."
          }
        }
      }
    },
    "settingsAboutPrivacy": {
      "comment": "Settings → About: link to StreamIn's privacy policy web page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidad"
          }
        }
      }
    },
    "settingsAboutVersion": {
      "comment": "Settings → About: the app version, then the build number in parentheses, e.g. Version 1.0.0 (1).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión %1$@ (%2$@)"
          }
        }
      }
    },
    "onboardingCredits": {
      "comment": "Onboarding: one quiet credit line at the end of the services list. Same copy as the landing page's credits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powered by TMDB · Availability by JustWatch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con datos de TMDB · Disponibilidad de JustWatch"
          }
        }
      }
    },
    "settingsStreamingServicesYourServices": {
      "comment": "Services picker: heading above the services you picked, with how many, e.g. Your services · 3.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your services · %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus servicios · %lld"
          }
        }
      }
    },
    "settingsLanguageRestartNote": {
      "comment": "Settings: second footer line under the Language picker, with a restart icon; says a new language applies only after StreamIn restarts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect after restarting StreamIn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al reiniciar StreamIn."
          }
        }
      }
    },
    "settingsStreamingServicesLoadFailed": {
      "comment": "Services picker: title shown in place of the grid when the list of services couldn't be loaded; the reason and a Retry button follow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the services"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar los servicios"
          }
        }
      }
    },
    "settingsRetry": {
      "comment": "Services picker: button that asks again for the list of services after a failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    },
    "settingsStreamingServicesAllPicked": {
      "comment": "Services picker: shown under 'Available in …' when every service there is already one of yours.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've picked every service here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has elegido todos los servicios de aquí."
          }
        }
      }
    },
    "settingsRegionSearchPrompt": {
      "comment": "Search field prompt on the home-region picker, which lists every country.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search countries"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar países"
          }
        }
      }
    },
    "settingsRegionSelectedHeader": {
      "comment": "Header above the home region currently picked, pinned at the top of the region picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your region"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu región"
          }
        }
      }
    },
    "settingsRegionAllHeader": {
      "comment": "Header above the full list of countries in the region picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All regions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las regiones"
          }
        }
      }
    },
    "settingsRegionLoadFailed": {
      "comment": "Title shown in the region picker when the country list couldn't be downloaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load regions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar las regiones"
          }
        }
      }
    }
  },
  "version": "1.0"
}
