      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to Watchlist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir a tu watchlist"
          }
        }
      }
    },
    "detailsWatchlistRemove" : {
      "comment" : "Label of the filled heart button in the Details toolbar when the movie is saved; VoiceOver reads it, the button shows only the heart.",
