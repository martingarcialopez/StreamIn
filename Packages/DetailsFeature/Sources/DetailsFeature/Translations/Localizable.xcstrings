        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hecho"
          }
        }
      }
    },
    "detailsRegionStripAccessibility" : {
      "comment" : "VoiceOver label for the region flag strip on a Details provider row. %1$@ is the provider name, %2$lld is the count of regions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, available in %2$lld other regions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, disponible en otras %2$lld regiones"
          }
        }
      }
    },
    "detailsWatchlistAdd" : {
      "comment" : "Label of the heart button in the Details toolbar when the movie isn't saved; VoiceOver reads it, the button shows only the heart.",
