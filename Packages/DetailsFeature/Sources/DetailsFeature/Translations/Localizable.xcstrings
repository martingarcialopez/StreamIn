{
  "sourceLanguage" : "en",
  "strings" : {
    "detailsCheckingAvailability" : {
      "comment" : "Shown on the Details screen while the providers list is loading",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking availability…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmando disponibilidad…"
          }
        }
      }
    },
    "detailsDirectedBy" : {
      "comment" : "Director credit on the Details screen; %@ is a locale-formatted list of director names",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directed by %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirigida por %@"
          }
        }
      }
    },
    "detailsLoadFailed" : {
      "comment" : "Error message on the Details screen when full details fail to load; %@ is the localized underlying error description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load full details. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los detalles. %@"
          }
        }
      }
    },
    "detailsRetry" : {
      "comment" : "Button on the Details screen that re-runs the failed full-details load",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retry"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reintentar"
          }
        }
      }
    },
    "detailsSubscriptionsEmptyConfigure" : {
      "comment" : "Empty state shown when the user has not configured any subscriptions",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the streaming services you pay for to see where you can watch this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los servicios de streaming que pagas para ver dónde puedes ver esta película."
          }
        }
      }
    },
    "detailsSubscriptionsConfigureButton" : {
      "comment" : "Button in the no-subscriptions state that opens the streaming-services picker",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your services"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir tus servicios"
          }
        }
      }
    },
    "detailsRegionsSheetDone" : {
      "comment" : "Done button that dismisses the full region list sheet",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hecho"
          }
        }
      }
    },
    "detailsRegionStripAccessibility" : {
      "comment" : "VoiceOver label for the region flag strip on a Details provider row. %1$@ is the provider name, %2$lld is the count of regions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, available in %2$lld other regions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, disponible en otras %2$lld regiones"
          }
        }
      }
    },
    "detailsWhereToWatchRegion" : {
      "comment" : "VoiceOver label of the Details 'where to watch' card title, whose visible text shows only the region's flag. %@ is the region name, e.g. 'Spain'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where to watch in %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde ver en %@"
          }
        }
      }
    },
    "detailsWhereToWatchTitle" : {
      "comment" : "Small title of the Details 'where to watch' card. %@ is the home region's flag emoji, e.g. '🇪🇸'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where to watch · %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde ver · %@"
          }
        }
      }
    },
    "detailsVerdictWatchNow" : {
      "comment" : "Verdict on the Details card when one of the user's services, or a free service, carries the film in their region",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch now"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes verla"
          }
        }
      }
    },
    "detailsVerdictAbroad" : {
      "comment" : "Verdict on the Details card when the film is only on the user's services in other countries",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your services abroad"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tus servicios en el extranjero"
          }
        }
      }
    },
    "detailsVerdictUnavailable" : {
      "comment" : "Playful verdict on the Details card when the user can't stream the film: not on their services anywhere and not free in their region",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go read a book"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca leer un libro"
          }
        }
      }
    },
    "detailsUnavailableNotOnYours" : {
      "comment" : "Line under 'Go read a book' when services the user doesn't have carry the film in their region",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not on your services, here or abroad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está en tus servicios, ni aquí ni fuera."
          }
        }
      }
    },
    "detailsUnavailableNowhere" : {
      "comment" : "Line under 'Go read a book' when no service carries the film in the user's region and none of theirs carries it abroad. 'Here' is the region the card's title shows with its flag.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not available to stream here or on your services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede ver en streaming aquí ni con tus servicios."
          }
        }
      }
    },
    "detailsAlsoOn" : {
      "comment" : "VoiceOver label for the small logos on the Details card's top border, when the user can already watch the film: the region's other services. Followed by their names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also on:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También en:"
          }
        }
      }
    },
    "detailsInRegion" : {
      "comment" : "VoiceOver label for the small logos on the Details card's top border: services the user doesn't have that carry the film in their region. %@ is the region name, e.g. 'Spain'. Followed by their names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@:"
          }
        }
      }
    }
  },
  "version" : "1.0"
}