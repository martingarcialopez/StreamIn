      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch with your subscriptions in other regions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible con tus suscripciones en otras regiones"
