      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible en"
          }
        }
      }
    },
    "detailsSubscriptionsHomeRegion" : {
      "comment" : "Section header above providers carrying the film in the user's home region. %@ is a 'flag + name' label, e.g. '🇪🇸 Spain'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch with your subscription in %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible con tu suscripción en %@"
          }
        }
      }
    },
    "detailsSubscriptionsHomeNotAvailable" : {
      "comment" : "Shown when none of the user's subscriptions carry the film in their home region. %@ is the 'flag + name' label for the home region.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not available with your subscriptions in %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible con tus suscripciones en %@"
          }
        }
      }
    },
    "detailsSubscriptionsOtherRegions" : {
      "comment" : "Section header above the per-provider flag strips for regions other than home (accessible via VPN)",
