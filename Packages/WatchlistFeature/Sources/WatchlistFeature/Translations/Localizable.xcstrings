    },
    "watchlistLoadFailedTitle" : {
      "comment" : "Title on the Watchlist screen when the saved movies couldn't be read from the device",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load your watchlist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido cargar tu watchlist"
          }
        }
      }
    },
    "watchlistLoadFailedDescription" : {
      "comment" : "Description under the title when the Watchlist couldn't be loaded; reassures that nothing was lost",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your saved movies are safe. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus películas guardadas siguen ahí. Inténtalo de nuevo en un momento."
          }
        }
      }
    },
    "watchlistRetry" : {
      "comment" : "Button that tries loading the Watchlist again after it failed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retry"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reintentar"
          }
        }
      }
    },
    "watchlistRowNotOnYourServices" : {
      "comment" : "Watchlist row, in place of provider logos: something streams the movie in the user's region, but none of the user's services",
