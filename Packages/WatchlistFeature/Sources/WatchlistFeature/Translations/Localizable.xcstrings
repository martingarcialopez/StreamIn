{
  "sourceLanguage" : "en",
  "strings" : {
    "watchlistDirectorsOverflow" : {
      "comment" : "Directors line under a movie title in a Watchlist row when the movie has three or more directors: the first two names, then how many more. %1$@ and %2$@ are director names, %3$lld is the number of remaining directors.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ & %3$lld more"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ y %3$lld más"
          }
        }
      }
    },
    "watchlistEmptyDescription" : {
      "comment" : "Hint under the headline on the empty Watchlist screen: how to save movies with the heart button on a movie's page, and what the list then shows",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the heart on a movie's page to save it here, and see at a glance where you can watch it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el corazón en la página de una película para guardarla aquí y ver de un vistazo dónde puedes verla."
          }
        }
      }
    },
    "watchlistEmptyTitle" : {
      "comment" : "Headline on the Watchlist screen when no movies have been saved",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing saved yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has guardado nada"
          }
        }
      }
    },
    "watchlistTitle" : {
      "comment" : "Navigation bar title for the Watchlist tab",
      "extractionState" : "manual",
      "localizations" : {
