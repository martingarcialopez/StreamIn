// Secrets.example.xcconfig — committed template.
//
// To set up locally:
//   cp Secrets.example.xcconfig Secrets.xcconfig
// Then edit Secrets.xcconfig and replace the placeholder with your real key.
// Secrets.xcconfig is gitignored.
//
// The value below is consumed by the "Generate Secrets" Run Script Phase
// on the StreamFinder app target, which writes it into GeneratedSecrets.swift
// at build time.

TMDB_API_KEY = your_tmdb_api_key_here
