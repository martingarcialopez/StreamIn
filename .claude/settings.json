{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin main)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(scripts/xcodebuild-locked.sh *)",
      "Bash(scripts/worktree-simulator.sh)",
      "Bash(plutil -lint *)",
      "Bash(xcrun xcstringstool *)",
      "Bash(xcrun simctl list *)",
      "Bash(xcodebuild -list *)",
      "Bash(python3 .claude/skills/localize/scripts/add_strings.py *)",
      "Bash(python3 .claude/skills/new-package/scripts/add_local_package.py *)"
    ],
    "deny": [
      "Read(./Secrets.xcconfig)",
      "Read(./StreamIn/Secrets/GeneratedSecrets.swift)"
    ]
  },
  "enabledMcpjsonServers": ["xcode"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-main-checkout.sh", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
